{
  "name": "@swiftdrop/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background worker: outbox relay, notification + webhook consumers (RabbitMQ). Owner: M8.",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
