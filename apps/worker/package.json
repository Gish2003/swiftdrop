    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@swiftdrop/contracts": "workspace:*",
    "@swiftdrop/db": "workspace:*",
    "amqp-connection-manager": "4.1.15",
    "amqplib": "2.2.0",
    "nodemailer": "10.1.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/nodemailer": "8.0.2",
    "chokidar": "5.0.0",
    "jest": "30.5.2",
    "typescript": "6.0.3"
  }
