{
  "name": "@swiftdrop/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema (split per module), migrations, generated client and seed data. See docs/conventions/database-migrations.md.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "migrate:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema --exit-code",
    "seed": "tsx seed/index.ts",
    "studio": "prisma studio --port 5555 --browser none",
    "format": "prisma format"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "argon2": "0.45.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
