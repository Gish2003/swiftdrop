// Owner: M4 (Parcel lifecycle & tracking). Booking fields are co-owned with M3.

/// Must match PARCEL_STATUSES in packages/contracts/src/parcel-status.ts
enum ParcelStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum ParcelSize {
  SMALL
  MEDIUM
  LARGE
}

enum ParcelSource {
  CUSTOMER
  MERCHANT_API
}

model Parcel {
  id                String       @id @default(cuid())
  /// Public identifier, format SD + 9 digits, e.g. SD123456789
  trackingNumber    String       @unique
  status            ParcelStatus @default(CREATED)
  source            ParcelSource @default(CUSTOMER)
  customerId        String?
  merchantId        String?
  /// Merchant's own order id; unique per merchant → idempotent merchant order creation
  merchantReference String?

  senderName      String
  senderPhone     String
  pickupAddress   String
  pickupCity      String
  pickupZoneId    String?
  recipientName   String
  recipientPhone  String
  recipientEmail  String?
  dropoffAddress  String
  dropoffCity     String
  dropoffZoneId   String?

  size             ParcelSize
  weightKg         Decimal    @db.Decimal(6, 2)
  description      String?
  /// Fee in minor units (cents) of `currency`
  feeCents         Int
  currency         String     @default("LKR")
  deliveryAttempts Int        @default(0)
  /// Private operational notes — never exposed on public tracking
  internalNotes    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?

  customer        User?                 @relation("CustomerParcels", fields: [customerId], references: [id])
  merchant        Merchant?             @relation(fields: [merchantId], references: [id])
  pickupZone      DeliveryZone?         @relation("PickupZone", fields: [pickupZoneId], references: [id])
  dropoffZone     DeliveryZone?         @relation("DropoffZone", fields: [dropoffZoneId], references: [id])
  statusHistory   ParcelStatusHistory[]
  assignments     CourierAssignment[]
  proofOfDelivery ProofOfDelivery?

  @@unique([merchantId, merchantReference])
  @@index([status])
  @@index([customerId])
  @@index([merchantId])
  @@index([createdAt])
  @@map("parcels")
}

/// Append-only. Every status change inserts one row in the same transaction as the parcel update.
model ParcelStatusHistory {
  id         String        @id @default(cuid())
  parcelId   String
  fromStatus ParcelStatus?
  toStatus   ParcelStatus
  actorId    String?
  /// Role name or "SYSTEM"
  actorRole  String
  reason     String?
  note       String?
  createdAt  DateTime      @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([parcelId, createdAt])
  @@map("parcel_status_history")
}
